}

> {%
    client.test("User PUT -> 403", function () {
        client.assert(response.status === 403, "Expected 403");
    });
%}


### 9. MANAGER - DELETE -> 403
DELETE {{host}}/api/BankAccounts/{{managerAccountId}}
Authorization: {{managerAuth}}
X-CSRF-TOKEN: {{managerCsrfToken}}

> {%
    client.test("Manager DELETE -> 403", function () {
